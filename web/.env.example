# Optional override of the published default host.
# Immutable HTTPS object-host root; do not include the revision or credentials.
# Set an empty value to disable Fletcher in an isolated build.
VITE_FLETCHER_TILE_BASE_URL=https://tiles.kinnokilabs.com

# Optional local review host for the 24 Fletcher sheets with aesthetic seam adjustments.
# Disabled by default; does not replace the published Fletcher layer.
# VITE_FLETCHER_FULL_SHEETS_TILE_BASE_URL=http://127.0.0.1:4198

# CHM pilot is disabled by default while the derived-product licence is provisional.
# Serve the local output parent using the documented preview command.
# Do not set the public host until licence confirmation and publication approval.
# VITE_CHM_TILE_BASE_URL=http://127.0.0.1:4199
