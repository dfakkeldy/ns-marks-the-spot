{
  "name": "ns-marks-the-spot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:hydro-pilot": "node scripts/generateInvernessHydroPilot.mjs",
    "refresh:cbrm-tax-sale-results": "node scripts/refreshCbrmTaxSaleResults.mjs",
    "refresh:inverness-tax-sale": "node scripts/refreshInvernessTaxSale.mjs",
    "refresh:tax-sales": "npm run refresh:inverness-tax-sale && npm run refresh:cbrm-tax-sale-results && npm run watch:tax-sales",
    "watch:tax-sales": "node scripts/watchTaxSaleSources.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "geotiff": "2.1.3",
    "leaflet": "1.9.4",
    "proj4": "^2.20.9",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.21",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "canvas": "^3.2.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "17.4.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
