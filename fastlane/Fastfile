# frozen_string_literal: true

# ── Fastfile for "NS Marks The Spot" ──────────────────────────────────────────
# MIT License — open-source iOS map app with historical tile overlays.

default_platform(:ios)

# ── Platform ------------------------------------------------------------------

platform :ios do

  # ── Global options (inherited by every lane) ──────────────────────────────

  before_all do |lane|
    # Ensure cocoapods / SPM dependencies are resolved if needed.
    # For now this project uses SPM, so no `cocoapods` call.
    UI.message "▶ Running lane: #{lane}"
  end

  after_all do |lane|
    UI.success "✓ Lane '#{lane}' finished successfully."
  end

  error do |lane, exception|
    UI.error "✗ Lane '#{lane}' failed: #{exception.message}"
  end

  # ── Lanes ─────────────────────────────────────────────────────────────────

  desc "Run unit tests on the primary scheme"
  lane :test do
    run_tests(
      scheme: "ns-marks-the-spot",
      devices: ["iPhone 17 Pro"],          # latest simulator
      only_testing: ["ns-marks-the-spotTests"],
      code_coverage: true,
      output_types: "html,junit"
    )
  end

  desc "Run UI tests on the primary scheme"
  lane :ui_test do
    run_tests(
      scheme: "ns-marks-the-spot",
      devices: ["iPhone 17 Pro"],
      only_testing: ["ns-marks-the-spotUITests"],
      output_types: "html,junit"
    )
  end

  desc "Run all tests (unit + UI) on the primary scheme"
  lane :test_all do
    run_tests(
      scheme: "ns-marks-the-spot",
      devices: ["iPhone 17 Pro"],
      code_coverage: true,
      output_types: "html,junit"
    )
  end

  desc "Build the app for the simulator — quick sanity check"
  lane :build do
    build_app(
      scheme: "ns-marks-the-spot",
      destination: "generic/platform=iOS Simulator",
      skip_codesigning: true,
      skip_archive: true
    )
  end

  desc "Build and run unit tests (what CI would do)"
  lane :ci do
    build
    test
  end

  # ── Placeholder lanes (uncomment and configure when ready) ────────────────

